@echo off
title سامانه هوشمند مدیریت سایلنت باکس ماینر (نسخه ویندوز)
cd /d "%~dp0"

echo =======================================================================
echo         سامانه برآورد قیمت و فرمول ساخت (BOM) سایلنت باکس ماینر
echo =======================================================================
echo.
echo [!] نکته بسیار مهم (در صورت توقف یا فریز شدن صفحه سیاه):
echo در محیط ویندوز اگر روی صفحه سیاه کلیک کنید، برنامه به حالت انتخاب (QuickEdit)
echo رفته و متوقف می‌شود. در این صورت یکبار دکمه Enter کیبورد را بزنید تا ادامه دهد!
echo =======================================================================
echo.

where node >nul 2>nul
if %errorlevel% neq 0 goto NODE_MISSING
goto NODE_OK

:NODE_MISSING
echo [X] خطای حیاتی: نرم‌افزار Node.js روی کامپیوتر شما نصب نیست!
echo.
echo [!] مرورگر شما الان به صورت خودکار باز می‌شود.
echo لطفاً نرم‌افزار Node.js نسخه LTS را دانلود و با زدن دکمه Next نصب کنید.
echo.
start https://nodejs.org/
echo -----------------------------------------------------------------------
echo برای بستن پنجره دکمه‌ای را بزنید...
pause
exit /b

:NODE_OK
echo [OK] نرم‌افزار Node.js روی سیستم شما شناسایی شد.
echo.

if exist "node_modules\" goto SKIP_INSTALL

echo [1/2] در حال دانلود و نصب کتابخانه‌های پروژه (بار اول ۱ تا ۲ دقیقه زمان می‌برد)...
echo لطفاً صبور باشید و پنجره را نبندید...
echo.
call npm install
if %errorlevel% neq 0 goto INSTALL_ERROR
echo.
echo [OK] کتابخانه‌ها با موفقیت دانلود و نصب شدند!
echo.
goto START_SERVER

:INSTALL_ERROR
echo.
echo [X] خطا در دانلود کتابخانه‌ها! لطفاً اتصال اینترنت یا فیلترشکن خود را بررسی کنید.
echo -----------------------------------------------------------------------
echo برای بستن پنجره دکمه‌ای را بزنید...
pause
exit /b

:SKIP_INSTALL
echo [OK] بررسی پوشه کتابخانه‌ها: موجود است -> عبور سریع از مرحله نصب (SKIP)
echo.

:START_SERVER
echo [2/2] در حال راه‌اندازی سرور محلی...
echo.
echo ***********************************************************************
echo   توجه: این پنجره سیاه نباید بسته شود! مرورگر اتوماتیک باز می‌شود:
echo   http://localhost:3000
echo ***********************************************************************
echo.

start "" http://localhost:3000
call npm run dev

echo.
echo [!] سرور متوقف شد یا با خطا مواجه شد.
echo -----------------------------------------------------------------------
echo برای بستن این پنجره دکمه‌ای را بزنید...
pause
